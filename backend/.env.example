# 环境变量配置模板
# 复制为 .env 后修改

# LLM配置
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-coder
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# Redis（可选，默认使用内存字典）
REDIS_URL=

# 会话过期时间（秒）
SESSION_TTL=3600

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# CodeBERT模型（语义层检测用，可选）
CODEBERT_MODEL=microsoft/codebert-base
